{% extends 'base.html.twig' %}

{% block title %}Votre panier{% endblock %}

{% block extra_scripts %}
{% endblock %}

{% block body %}


        <h1>Panier </h1>
    {% if items| length > 0 %}
        <table class="table">
            <thead>
                <th></th>
                <th>Produit</th>
                <th>Prix</th>
                <th>Quantité</th>
                <th>Total</th>
                <th></th>
            </thead>
            <tbody>
            {% for item in items %}
                <tr>
                    <td>
                        <a href="{{ path('product_show', {
                            'category_slug': item.product.category.slug,
                            'slug': item.product.slug
                        }) }}">
                            <img class='cart-image' src="{{ item.product.mainPicture }}"
                            alt="{{ item.product.name }}">
                        </a>
                    </td>
                    <td>{{item.product.name}}</td>
                    <td>{{item.product.price/100}} €</td>


<td>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-danger" href="{{ path('cart_decrement', {'id': item.product.id}) }}">
            <i class="fas fa-minus"></i>
        </a>
        <span class="fw-bold px-2">{{ item.qty }}</span>
        <a class="btn btn-sm btn-success" href="{{ path('cart_add', {'id': item.product.id}) }}?returnToCart=true">
            <i class="fas fa-plus"></i>
        </a>
    </div>
</td>



                    <td>{{item.total /100}} € </td>
                    <td>
                        <a href="{{ path('cart_delete', {'id' : item.product.id}) }}" class="btn btn-sm btn-danger">
                             <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            {% endfor%}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4">Total:</td>
                    <td colspan="3">{{total/100}} €</td>
                </tr>
            </tfoot>
        </table>
        <hr>

        {% if app.user %}
            <h2>Confirmez votre commande en remplissant ce formulaire</h2>
            {{ form_start( confirmationForm, {'action': path('purchase_confirm')} ) }}

            {{ form_widget(confirmationForm) }}
            <button class="submit btn btn-success">Je confirme</button>

            {{ form_end(confirmationForm) }}
        {% else %}
            <h2>Vous devez vous connecter pour confirmer cette commande.</h2>
            <button type="button" class="btn btn-success" data-toggle="modal" data-target="#loginModal">Connexion</button>
            ou <button type="button" class="btn btn-link p-0" data-toggle="modal" data-target="#signupModal">Créez un compte</button>
        {% endif %}

    {% else %}
        <h5>Votre panier est vide</h5>
    {% endif %}

    <!-- Login Modal -->
    <div class="modal fade" id="loginModal" tabindex="-1" role="dialog" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">Connexion</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    {{ form_start(loginForm, {'action': path('security_login')}) }}
                    {{ form_widget(loginForm) }}
                    <button type="submit" class="btn btn-success">Connexion</button>
                    {{ form_end(loginForm) }}
                </div>
            </div>
        </div>
    </div>

    <!-- Signup Modal -->
    <div class="modal fade" id="signupModal" tabindex="-1" role="dialog" aria-labelledby="signupModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="signupModalLabel">Créer un compte</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    {{ form_start(signupForm, {'action': path('inscription')}) }}
                    {{ form_widget(signupForm) }}
                    <button type="submit" class="btn btn-success">Créer un compte</button>
                    {{ form_end(signupForm) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
